{
  "name": "autobot-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:analytics-dev": "ACC_ANALYTICS_SHOWCASE=1 node scripts/build.mjs",
    "analytics:compile": "node collector/web-analytics/compiler.mjs",
    "analytics:showcase": "node collector/web-analytics/showcase.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:standalone": "ACC_PLUGIN_PATH=/ playwright test --config=playwright.standalone.config.mjs",
    "security:public": "node scripts/check-public-safety.mjs",
    "check": "npm run test && npm run build && npm run test:e2e && npm run test:standalone && npm run security:public"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.0",
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vitest": "^3.2.4"
  }
}
