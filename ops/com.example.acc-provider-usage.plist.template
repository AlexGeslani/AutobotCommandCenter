<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.acc-provider-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__ACC_ROOT__/collector/bin/scheduled-provider-usage.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ACC_ROOT__</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ACC_PROVIDER_USAGE_SNAPSHOTS</key>
    <string>__OUTPUT_PATHS__</string>
    <key>ACC_BRAVE_HERMES_ENV_FILE</key>
    <string>__BRAVE_HERMES_ENV_FILE__</string>
    <key>ACC_BRAVE_PAID_OVERAGE_ENABLED</key>
    <string>__BRAVE_PAID_OVERAGE_ENABLED__</string>
    <key>ACC_ELEVENLABS_ENV_FILE</key>
    <string>__ELEVENLABS_ENV_FILE__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/provider-usage-collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/provider-usage-collector.error.log</string>
</dict>
</plist>
