{
  "version": "web-analytics-metrics-v2",
  "archiveSchemaVersions": [1],
  "queryVersions": ["httpRequestsAdaptiveGroups-safe-v1"],
  "totalsGroup": "hourly",
  "headlineMetrics": ["requests", "edge_response_bytes", "visits"],
  "visits": {
    "source": "sum.visits",
    "rangeAggregation": "sum_closed_utc_days",
    "label": "Cloudflare Visits",
    "notUniquePeopleOrSessions": true
  },
  "strictCacheHit": {
    "numeratorStatuses": ["hit"],
    "denominator": "all_cache_status_requests",
    "label": "Strict cache-hit share"
  },
  "excludedMetrics": []
}