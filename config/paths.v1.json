{
  "schemaVersion": "acc-path-config-v1",
  "paths": {
    "hiveMindClient": {
      "kind": "file",
      "required": true,
      "default": "scripts/knowledge_search.py"
    },
    "hiveMindTokenFile": {
      "kind": "file",
      "required": true,
      "default": ".runtime/secrets/bridge-token"
    },
    "hiveMindTlsPinFile": {
      "kind": "file",
      "required": false,
      "default": null
    },
    "providerUsagePrivateCacheDir": {
      "kind": "directory",
      "required": false,
      "default": ".runtime/provider-cache"
    },
    "braveHermesEnvFile": {
      "kind": "file",
      "required": false,
      "default": ".env"
    }
  }
}
